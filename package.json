{
  "name": "baseball-fan-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "KBO 야구 카드 대시보드 — 마이팀 라인업을 등급 색상 카드로 30초 안에 판독",
  "scripts": {
    "dev": "next dev",
    "dev:seed": "node scripts/seed-dev.mjs && next dev",
    "seed:dev": "node scripts/seed-dev.mjs",
    "prebuild": "node scripts/copy-baseball-assets.mjs",
    "build": "next build",
    "storybook:assets": "node scripts/copy-baseball-assets.mjs",
    "storybook:roster": "tsx scripts/crawler/kia-roster.ts",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:forbidden": "node scripts/check-forbidden-words.mjs",
    "crawl:schedule": "tsx scripts/crawler/index.ts schedule",
    "crawl:schedule:browser": "cross-env KBO_SCHEDULE_BROWSER=1 tsx scripts/crawler/index.ts schedule",
    "crawl:standings": "tsx scripts/crawler/index.ts standings",
    "crawl:lineup": "tsx scripts/crawler/index.ts lineup",
    "crawl:stats": "tsx scripts/crawler/index.ts stats",
    "compute:grades": "tsx scripts/compute-grades.ts",
    "ci": "pnpm typecheck && pnpm lint && pnpm check:forbidden && pnpm test && pnpm build"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "swr": "^2.2.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-plugin-import": "^2.29.1",
    "postcss": "^8.4.40",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.0"
}
