# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Crawler (server only)
KBO_USER_AGENT="baseball-fan-dashboard/0.1 (+https://example.com/contact)"
STATIZ_USER_AGENT="baseball-fan-dashboard/0.1 (+https://example.com/contact)"
CRAWL_RETRY_MAX=3
CRAWL_RETRY_DELAY_MS=4000

# Discord notifications (server only)
DISCORD_WEBHOOK_URL=

# Sentry (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Storybook (kia-player-storybook feature)
# Naver Developers Console → Application → "검색" API
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
