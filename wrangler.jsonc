{
  // Cloudflare Workers config for the OpenNext build of baseball-fan-dashboard.
  // Data (data/*.json) is shipped as static assets under /cfdata and read at
  // runtime via the ASSETS binding (no filesystem on Workers). Comments use KV.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseball-fan-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "COMMENTS_KV",
      "id": "e18f2fae986a4cddabab58ddbe39c28c"
    }
  ]
}
